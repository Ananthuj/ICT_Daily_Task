        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HR_Data.csv+ (Multiple Connections)' name='federated.1pxdtve08g5rgx19xt7ap1ajwemu' />
          </datasources>
          <datasource-dependencies datasource='federated.1pxdtve08g5rgx19xt7ap1ajwemu'>
            <column caption='Tenture' datatype='integer' name='[Calculation_1768788795011698689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([DateofTermination]) THEN &#13;&#10;DATEDIFF(&apos;year&apos;, [DateofHire], TODAY())&#13;&#10;ELSE &#13;&#10;DATEDIFF(&apos;year&apos;, [DateofHire], [DateofTermination])&#13;&#10;END' />
            </column>
            <column caption='Dateof Hire' datatype='date' name='[DateofHire]' role='dimension' type='ordinal' />
            <column caption='Dateof Termination' datatype='date' name='[DateofTermination]' role='dimension' type='ordinal' />
            <column caption='Emp ID' datatype='integer' name='[EmpID]' role='dimension' type='ordinal' />
            <column caption='First Name' datatype='string' name='[FirstName]' role='dimension' type='nominal' />
            <column caption='Last Name' datatype='string' name='[LastName]' role='dimension' type='nominal' />
            <column-instance column='[FirstName]' derivation='Attribute' name='[attr:FirstName:nk]' pivot='key' type='nominal' />
            <column-instance column='[LastName]' derivation='Attribute' name='[attr:LastName:nk]' pivot='key' type='nominal' />
            <column-instance column='[EmpID]' derivation='None' name='[none:EmpID:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1768788795011698689]' derivation='Sum' name='[sum:Calculation_1768788795011698689:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='display' class='0' field='[federated.1pxdtve08g5rgx19xt7ap1ajwemu].[sum:Calculation_1768788795011698689:qk]' scope='rows' value='false' />
