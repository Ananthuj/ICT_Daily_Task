      <column caption='Tenture' datatype='integer' name='[Calculation_1768788795011698689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([DateofTermination]) THEN &#13;&#10;DATEDIFF(&apos;year&apos;, [DateofHire], TODAY())&#13;&#10;ELSE &#13;&#10;DATEDIFF(&apos;year&apos;, [DateofHire], [DateofTermination])&#13;&#10;END' />
      </column>
      <column caption='Salary Bracket' datatype='string' name='[Calculation_1768788795015303170]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Salary] &lt; 60000 THEN&#13;&#10;    &quot;&lt;60K&quot;&#13;&#10;ELSEIF [Salary] &gt;= 60000 AND [Salary] &lt;= 90000 THEN&#13;&#10;    &quot;60K-90K&quot;&#13;&#10;ELSE&#13;&#10;    &quot;&gt;90K&quot;&#13;&#10;END' />
      </column>
